			PantsColor = rgb(52, 73, 94),
			ArmColor = rgb(142, 68, 173),
			Description = {},
		},
	},
	{
		CharacterId = "Muriloso",
		DisplayName = "Muriloso",
		ModelName = "Muriloso",
		IsMain = true,
